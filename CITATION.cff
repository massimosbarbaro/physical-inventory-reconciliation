repository-code: "https://github.com/massimosbarbaro/physical-inventory-reconciliation"
keywords:
  - "Visual Basic 6"
  - "inventory"
  - "stock count"
  - "barcode terminals"
  - "MFG/PRO"
  - "legacy software"
